# Copy to .env and adjust. Every value below has a working default for local
# Docker Compose, so `docker compose up` works with no edits at all.

# Host port for the API. Change it if something else already holds 8000.
API_PORT=8000

ENVIRONMENT=local
LOG_LEVEL=INFO
JSON_LOGS=true

# Host-facing, because that is the only thing that reads it. Compose sets the
# api container's DATABASE_URL to `db:5432` itself, so this value never reaches
# the container — it is for tooling running on your machine, LangGraph Studio
# above all. 5433 is the port Compose publishes Postgres on.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/meetings

UPLOAD_DIR=/data/uploads

# Not used until slice 1 (ingestion). Left blank so slice 0 runs without a key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Structured extraction at ingest: decisions, commitments, open threads. The one
# ingest step that makes a completion call per window of transcript, so it is the
# expensive one. Turn it off to load a back catalogue quickly, then turn it on.
EXTRACTION_ENABLED=true

# Optional tracing. Everything works with this off.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=meeting-intelligence
# LANGSMITH_API_KEY=
